# =============================================================================
# G. Dinesh Krishan Portfolio — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# Server configuration
PORT=8000
HOST=0.0.0.0

# CORS — comma-separated allowed origins (use * for development only)
# In production on Render, the frontend and backend are served from the same
# origin so * is safe, but you can restrict it to your Render URL:
# CORS_ORIGINS=https://your-app-name.onrender.com
CORS_ORIGINS=*
